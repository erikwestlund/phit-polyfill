{
    "name": "phpstats/phit-polyfill",
    "description": "Pure-PHP polyfill for the phit native extension: descriptive statistics, OLS/logistic/probit/Poisson regression and probability distributions",
    "type": "library",
    "license": "MIT",
    "keywords": ["statistics", "polyfill", "regression", "distributions", "phit"],
    "homepage": "https://phpstats.github.io/phit/",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "provide": {
        "ext-phit": "*"
    },
    "autoload": {
        "psr-4": {
            "Phit\\Polyfill\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phit\\Polyfill\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "\"$HOME/Library/Application Support/Herd/bin/php85\" vendor/bin/pest",
        "test:ext": "\"$HOME/Library/Application Support/Herd/bin/php85\" -d extension=.ext/libphit.dylib vendor/bin/pest",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
